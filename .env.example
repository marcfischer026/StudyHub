# Copy to .env and fill in what you need. .env is git-ignored — never commit real keys.
# UniVerse itself needs no API key: Claude is used via copy & paste, everything else runs locally.

# Only for modal_training/: Hugging Face token for gated base models (e.g. Llama).
# Better: store it as a Modal secret instead of a file:
#   modal secret create huggingface HF_TOKEN=hf_...
HF_TOKEN=

# Point UniVerse at another data folder (handy for testing).
# UNIVERSE_DATA_DIR=/tmp/universe-test
